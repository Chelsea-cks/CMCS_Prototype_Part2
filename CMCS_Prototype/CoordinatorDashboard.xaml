<UserControl x:Class="CMCS_Prototype.Views.CoordinatorDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="520" Width="640" Background="White">
    <Grid Margin="12">
        <StackPanel Width="760">
            <TextBlock Text="Coordinator - Claims Verification" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <DataGrid x:Name="DgClaims" AutoGenerateColumns="False" IsReadOnly="True" Height="360" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Lecturer" Binding="{Binding LecturerName}" Width="150"/>
                    <DataGridTextColumn Header="Submitted" Binding="{Binding SubmittedOn, StringFormat=g}" Width="140"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount}" Width="110"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                    <DataGridTextColumn Header="Document" Binding="{Binding SupportingDocumentPath}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Button x:Name="BtnVerify" Content="Verify (select row first)" Width="180" Click="BtnVerify_Click"/>
                <Button x:Name="BtnApprove" Content="Approve" Width="120" Margin="8,0,0,0" Click="BtnApprove_Click"/>
                <Button x:Name="BtnReject" Content="Reject" Width="120" Margin="8,0,0,0" Click="BtnReject_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
