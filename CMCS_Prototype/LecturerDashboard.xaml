<Window x:Class="CMCS_Prototype.LecturerDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CMCS_Prototype"
        mc:Ignorable="d"
        Title="LecturerDashboard" Height="450" Width="800">
    <Grid Margin="12">
        <StackPanel Width="520">
            <TextBlock Text="Lecturer Claim Submission" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Lecturer:" Width="120"/>
                <TextBox x:Name="TxtLecturerName" Width="300" Text="Mr Paul"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Hours Worked:" Width="120"/>
                <TextBox x:Name="TxtHours" Width="120"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Hourly Rate (ZAR):" Width="120"/>
                <TextBox x:Name="TxtRate" Width="120"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Notes:" Width="120"/>
                <TextBox x:Name="TxtNotes" Width="300" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12">
                <Button x:Name="BtnSubmit" Content="Submit Claim" Width="140" Click="BtnSubmit_Click"/>
                <Button x:Name="BtnUpload" Content="Upload Supporting Document" Width="200" Margin="8,0,0,0" Click="BtnUpload_Click"/>
                <TextBlock x:Name="UploadFileName" Margin="8,6,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <Button x:Name="BtnTrack" Content="Show My Claims" Width="140" Margin="0,10,0,0" Click="BtnTrack_Click"/>

            <DataGrid x:Name="DgMyClaims" AutoGenerateColumns="False" IsReadOnly="True" Height="220" Margin="0,12,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Submitted" Binding="{Binding SubmittedOn, StringFormat=g}" Width="140"/>
                    <DataGridTextColumn Header="Amount (ZAR)" Binding="{Binding TotalAmount}" Width="110"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                    <DataGridTextColumn Header="Document" Binding="{Binding SupportingDocumentPath}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Window>
