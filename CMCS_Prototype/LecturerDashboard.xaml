<Window x:Class="CMCS_Prototype.Views.LecturerDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lecturer Dashboard"
        Height="300" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Welcome, Lecturer!" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
            <Button Content="Submit Claim" Click="SubmitClaim_Click" Margin="0,10" Height="40"/>
            <Button Content="View Claims" Click="ViewClaims_Click" Margin="0,10" Height="40"/>
            <Button Content="Logout" Click="Logout_Click" Margin="0,10" Height="40"/>
        </StackPanel>
    </Grid>
</Window>
