<UserControl x:Class="CMCS_Prototype.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="520" Width="640" Background="White">
    <Grid Margin="12">
        <StackPanel>
            <TextBlock Text="Dashboard - Claim Status Overview" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,6" VerticalAlignment="Top">
                <StackPanel Margin="8">
                    <TextBlock Text="Submitted" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtSubmitted" FontSize="20" />
                </StackPanel>
                <StackPanel Margin="8">
                    <TextBlock Text="Pending" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtPending" FontSize="20" />
                </StackPanel>
                <StackPanel Margin="8">
                    <TextBlock Text="Coordinator Approved" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtCoordApproved" FontSize="20" />
                </StackPanel>
                <StackPanel Margin="8">
                    <TextBlock Text="Manager Approved" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtManagerApproved" FontSize="20" />
                </StackPanel>
                <StackPanel Margin="8">
                    <TextBlock Text="Rejected" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtRejected" FontSize="20" />
                </StackPanel>
            </WrapPanel>

            <Button Content="Refresh" Width="100" Click="BtnRefresh_Click" Margin="0,12,0,0"/>
            <DataGrid x:Name="DgAll" AutoGenerateColumns="False" IsReadOnly="True" Height="360" Margin="0,10,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Lecturer" Binding="{Binding LecturerName}" Width="150"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount}" Width="110"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                    <DataGridTextColumn Header="Submitted" Binding="{Binding SubmittedOn, StringFormat=g}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
