<UserControl x:Class="CMCS_Prototype.Views.ManagerDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="520" Width="640" Background="White">
    <Grid Margin="12">
        <StackPanel>
            <TextBlock Text="Academic Manager - Final Approval" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <DataGrid x:Name="DgToReview" AutoGenerateColumns="False" IsReadOnly="True" Height="360" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Lecturer" Binding="{Binding LecturerName}" Width="150"/>
                    <DataGridTextColumn Header="Submitted" Binding="{Binding SubmittedOn, StringFormat=g}" Width="140"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount}" Width="110"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                    <DataGridTextColumn Header="Document" Binding="{Binding SupportingDocumentPath}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Button x:Name="BtnFinalApprove" Content="Final Approve" Width="140" Click="BtnFinalApprove_Click"/>
                <Button x:Name="BtnManagerReject" Content="Reject" Width="120" Margin="8,0,0,0" Click="BtnManagerReject_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
