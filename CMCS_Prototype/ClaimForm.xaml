<Window x:Class="CMCS_Prototype.Views.ClaimForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lecturer Claim Form"
        Height="500" Width="450"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Lecturer Claim Form" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Lecturer Name:" Margin="0,5,0,0"/>
            <TextBox x:Name="LecturerNameBox" Margin="0,5"/>

            <TextBlock Text="Hours Worked:" Margin="0,5,0,0"/>
            <TextBox x:Name="HoursWorkedBox" Margin="0,5"/>

            <TextBlock Text="Hourly Rate:" Margin="0,5,0,0"/>
            <TextBox x:Name="HourlyRateBox" Margin="0,5"/>

            <TextBlock Text="Notes:" Margin="0,5,0,0"/>
            <TextBox x:Name="NotesBox" AcceptsReturn="True" Height="60" Margin="0,5"/>

            <Button x:Name="SubmitBtn" Content="Submit Claim" Background="Green" Foreground="White"
                    FontWeight="Bold" Margin="0,15" Height="40" Click="SubmitBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
