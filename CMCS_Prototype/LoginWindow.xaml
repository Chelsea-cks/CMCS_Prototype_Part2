<Window x:Class="CMCS_Prototype.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lecturer Login"
        Height="300" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Lecturer Login" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>

            <TextBlock Text="Username:" Margin="0,10,0,0"/>
            <TextBox x:Name="UsernameBox" Margin="0,2,0,10"/>

            <TextBlock Text="Password:" Margin="0,5,0,0"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,2,0,10"/>

            <Button x:Name="LoginButton" Content="Login" Background="Green" Foreground="White"
                    Margin="0,15" Height="40" Click="LoginButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
