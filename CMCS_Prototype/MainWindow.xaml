<Window x:Class="CMCS_Prototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contract Monthly Claim System" Height="550" Width="900" Background="White">
    <Grid>
        <DockPanel>
            <StackPanel DockPanel.Dock="Left" Background="White" Width="220" Margin="6" >
                <TextBlock Text="CMCS Menu" FontSize="20" FontWeight="Bold" Margin="10"/>
                <Button x:Name="BtnLecturer" Content="Lecturer" Margin="6" Click="BtnLecturer_Click"/>
                <Button x:Name="BtnCoordinator" Content="Programme Coordinator" Margin="6" Click="BtnCoordinator_Click"/>
                <Button x:Name="BtnManager" Content="Academic Manager" Margin="6" Click="BtnManager_Click"/>
                <Button x:Name="BtnDashboard" Content="Dashboard" Margin="6" Click="BtnDashboard_Click"/>
            </StackPanel>

            <ContentControl x:Name="MainContent" Margin="8" />
        </DockPanel>
    </Grid>
</Window>
